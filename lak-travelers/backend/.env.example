NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/lak-travelers
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

EMAIL_USER=
EMAIL_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Review notifications: reuse EMAIL_USER / EMAIL_PASS (Gmail), or configure all SMTP values below.
ADMIN_REVIEW_EMAIL=
PUBLIC_APP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Render Free: HTTPS email, used for OTPs and review notifications.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
